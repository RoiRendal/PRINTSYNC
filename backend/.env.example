NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LOG_LEVEL=info

# Only needed when the API serves the built SPA from a non-standard location.
# When unset, `src/app.ts` looks for `frontend/dist` relative to the repository.
# FRONTEND_DIST=

# --- AI insight reports (Gemini) -------------------------------------------
# SERVER-SIDE ONLY. Never prefix this with VITE_ — that would inline it into the
# browser bundle, where anyone can read it. Read once, in
# `src/integrations/gemini/client.ts`; never logged, never returned.
#
# Optional: without it POST /api/v1/analytics/insights answers 503
# AI_NOT_CONFIGURED and everything else keeps working (including the
# non-AI analytics), so a developer without a key can still run the stack.
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# The model failover chain, in order, comma-separated. On a quota (429) error
# the request falls through to the next model. Left unset, the chain in
# `src/integrations/gemini/models.ts` applies. Kept configurable because Google
# retires models without notice — correcting a dead model should not need a
# redeploy of the image.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
